FROM node:22-bookworm-slim AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY resources ./resources
COPY vite.config.js ./
ARG VITE_REVERB_APP_KEY
ARG VITE_REVERB_HOST
ENV VITE_REVERB_APP_KEY=$VITE_REVERB_APP_KEY VITE_REVERB_HOST=$VITE_REVERB_HOST VITE_REVERB_PORT=443 VITE_REVERB_SCHEME=https
RUN npm run build

FROM php:8.3-fpm-bookworm AS app
RUN apt-get update && apt-get install -y --no-install-recommends unzip libpq-dev libicu-dev libzip-dev libonig-dev libxml2-dev \
 && docker-php-ext-install pdo_pgsql intl zip mbstring bcmath pcntl dom xml xmlwriter opcache \
 && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /app
COPY . .
RUN composer install --no-dev --prefer-dist --no-interaction --optimize-autoloader \
 && mkdir -p storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
 && chown -R www-data:www-data storage bootstrap/cache
COPY --from=assets /app/public/build ./public/build
COPY docker/php-production.ini /usr/local/etc/php/conf.d/meda.ini
COPY docker/production-entrypoint.sh /usr/local/bin/meda-entrypoint
RUN chmod +x /usr/local/bin/meda-entrypoint
USER www-data
ENTRYPOINT ["meda-entrypoint"]
CMD ["php-fpm", "-F"]

FROM caddy:2-alpine AS web
COPY --from=app /app/public /srv/public
COPY docker/Caddyfile /etc/caddy/Caddyfile
