APP_NAME="Meda Pass"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://booking.example.com
MEDA_DOMAIN=booking.example.com
# Set this to the actual ingress proxy address/network. Never use * on a directly exposed PHP service.
TRUSTED_PROXIES=
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=meda
DB_USERNAME=meda
DB_PASSWORD=
DB_SSLMODE=prefer
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
MEDA_MOCK_AUTH=false
MEDA_MOCK_PAYMENTS=false
MEDA_STAFF_MFA=true
MEDA_QR_ACTIVE_KEY=v1
MEDA_QR_KEY_V1=
MEDA_QR_KEY_V2=
MEDA_OPERATOR_NAME=
MEDA_SUPPORT_EMAIL=
MEDA_SUPPORT_PHONE=
MEDA_POLICIES_APPROVED=false
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=booking.example.com
FAYDA_ENABLED=false
FAYDA_ISSUER=
FAYDA_AUTHORIZATION_URL=
FAYDA_TOKEN_URL=
FAYDA_JWKS_URL=
FAYDA_CLIENT_ID=
FAYDA_CLIENT_AUTH=private_key_jwt
FAYDA_CLIENT_SECRET=
FAYDA_KEY_ID=
FAYDA_PRIVATE_KEY_PATH=/run/secrets/fayda-private.pem
FAYDA_SUBJECT_PEPPER=
TELEBIRR_ENABLED=false
TELEBIRR_CONTRACT_APPROVED=false
TELEBIRR_TOKEN_URL=
TELEBIRR_PREORDER_URL=
TELEBIRR_QUERY_URL=
TELEBIRR_CHECKOUT_URL=
TELEBIRR_FABRIC_APP_ID=
TELEBIRR_APP_SECRET=
TELEBIRR_MERCHANT_APP_ID=
TELEBIRR_MERCHANT_CODE=
TELEBIRR_PRIVATE_KEY_PATH=/run/secrets/telebirr-private.pem
TELEBIRR_PROVIDER_KEY_PATH=/run/secrets/telebirr-provider-public.pem
TELEBIRR_SIGNATURE_ALGORITHM=
TELEBIRR_SIGN_TYPE=SHA256WithRSA
# Confirm every field, status and acknowledgement with the approved merchant contract.
TELEBIRR_REFERENCE_FIELD=payment_order_id
TELEBIRR_STATUS_FIELD=trade_status
TELEBIRR_SUCCESS_STATUS=SUCCESS
TELEBIRR_FAILURE_STATUSES=FAILED,CLOSED
TELEBIRR_ACKNOWLEDGEMENT=success
TELEBIRR_AUTHORIZATION_PREFIX="Bearer "
TELEBIRR_QUERY_METHOD=payment.queryorder
